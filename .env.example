###############################################################################
#  .env.example — Environment Variables for the Private AI Platform
#
#  📋 Instructions:
#     1. Copy this file to .env:   cp .env.example .env
#     2. Fill in ALL values marked with <...>
#     3. NEVER commit the .env file to Git (it is in .gitignore)
#
#  🧠 100% Agnostic: does not contain any client data.
#     The CI/CD deploy jobs generate the .env dynamically from GitHub Secrets.
#     This file is provided for local/manual deployment reference only.
#
#  🏢 ONBOARDING A NEW CLIENT
#     Create an Environment in GitHub (Settings → Environments) and define:
#
#     SECRETS (sensitive values, write-only):
#       ACR_PASSWORD                      Container registry password
#       AZURE_STORAGE_CONNECTION_STRING   Storage Account connection string
#       CLOUDFLARE_TUNNEL_TOKEN           Client's tunnel token
#       WEBUI_ADMIN_PASSWORD              Admin password
#       WEBUI_SECRET_KEY                  Use: openssl rand -hex 32
#
#     Mandatory VARIABLES:
#       ACR_LOGIN_SERVER                  <acr>.azurecr.io
#       ACR_USERNAME                      Registry username
#       WEBUI_ADMIN_EMAIL                 Admin email
#
#     Optional VARIABLES (if omitted, falls back to the defaults below):
#       WEBUI_NAME, WEBUI_ADMIN_NAME, DEFAULT_LOCALE,
#       CUSTOM_MODEL_NAME, CUSTOM_MODEL_ID, KNOWLEDGE_BASE_NAME,
#       AZURE_DOCS_CONTAINER, AZURE_CONFIG_CONTAINER,
#       DEFAULT_MODELS, OLLAMA_PULL_MODELS,
#       RAG_EMBEDDING_MODEL, RAG_TOP_K, CHUNK_SIZE, CHUNK_OVERLAP,
#       ENABLE_WEB_SEARCH, SYNC_INTERVAL_MINUTES, INGEST_INTERVAL_MINUTES
###############################################################################

# ─── Microservices Images (populated by CI/CD) ───────────────────────────────
#  A single tag applies to storage-sync, rag-ingestor, and webui-bootstrap.
ACR_REGISTRY=<your-acr>.azurecr.io
SYNC_IMAGE_TAG=latest

# ─── Azure Storage Account ───────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=<DefaultEndpointsProtocol=https;AccountName=...>
AZURE_DOCS_CONTAINER=documents
AZURE_CONFIG_CONTAINER=config

# ─── Intervals (in minutes) ──────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15        # Azure → local disk
INGEST_INTERVAL_MINUTES=15      # local disk → knowledge base
INGEST_PROCESS_TIMEOUT=300      # Seconds to wait for doc indexing

# ─── Cloudflare Tunnel ───────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=<your-cloudflare-tunnel-token>

# ─── Open-WebUI Configuration ────────────────────────────────────────────────
WEBUI_PORT=3000
WEBUI_AUTH=true
WEBUI_NAME=AI Assistant
DEFAULT_LOCALE=en-US
OPEN_WEBUI_URL=http://open-webui:8080

# Session signing key. If changed, all users are logged out.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=<64-char-random-string>

# Allows webui-bootstrap to register the first admin.
# Open-WebUI automatically disables this after creating the first user.
ENABLE_SIGNUP=true

# ─── Admin Account (created by webui-bootstrap) ──────────────────────────────
#  ⚠️ Not native Open-WebUI variables: consumed by our bootstrap job which
#     POSTs to /api/v1/auths/signup. The first registered user gets 'admin' role.
WEBUI_ADMIN_EMAIL=admin@company.ai
WEBUI_ADMIN_PASSWORD=<strong-password-from-github-secrets>
WEBUI_ADMIN_NAME=Administrator

# ─── Custom Model Personalization ────────────────────────────────────────────
CUSTOM_MODEL_NAME=Corporate AI
CUSTOM_MODEL_ID=corporate-ai
KNOWLEDGE_BASE_NAME=Company Documents

# ─── Default AI Models ───────────────────────────────────────────────────────
DEFAULT_MODELS=llama3.1:latest

# Models that the ollama-puller service downloads on boot. Comma-separated wait_for_api.
# On a fresh install, the engine boots empty, so this value must include
# at least the base model defined in DEFAULT_MODELS.
OLLAMA_PULL_MODELS=llama3.1:latest

# ─── RAG Pipeline (extraction & vector store are separated containers) ───────
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
ENABLE_WEB_SEARCH=false
