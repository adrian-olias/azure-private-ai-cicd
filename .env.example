# Reference for a manual run. In CI/CD the deploy script writes this file on the
# VM and deletes it when the stack is up. Never commit a real .env.

# Images built by CI, one tag per service. ACR_REGISTRY is <ACR_NAME>.azurecr.io
ACR_REGISTRY=crprivateailabxxxx.azurecr.io
DOCS_SYNC_TAG=dev-abc1234
WEBUI_BOOTSTRAP_TAG=dev-abc1234

# Documents to index, read with the VM's managed identity (no key)
AZURE_STORAGE_ACCOUNT=stprivateailabxxxx
AZURE_DOCS_CONTAINER=documents

# Secrets. CI/CD reads them from Key Vault: webui-secret-key, webui-admin-password
WEBUI_SECRET_KEY=change-me
WEBUI_ADMIN_PASSWORD=change-me

# Settings: GitHub environment variables in CI/CD. docker-compose.yml has no defaults,
# so every one of these must be set here for a manual run
OLLAMA_VERSION=0.40.6
OPEN_WEBUI_VERSION=v0.12.4
OPEN_WEBUI_PORT=3000
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_NAME=Admin
WEBUI_NAME=Private AI
CUSTOM_MODEL_ID=private-ai
CUSTOM_MODEL_NAME=Private AI
SYSTEM_PROMPT=
DEFAULT_LOCALE=en-US
ENABLE_SIGNUP=false
ENABLE_WEB_SEARCH=false
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KNOWLEDGE_BASE_NAME=Company Documents
BASE_MODEL=llama3.2:3b
OLLAMA_MODELS=llama3.2:3b
AZURE_DOCS_CONTAINER=documents
SYNC_INTERVAL_MINUTES=15
